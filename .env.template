HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
# Версия и порты
MYSQL_IMAGE_TAG=8.0
MYSQL_PORT=3306
MYSQL_EXT_PORT=3306
MYSQL_HOST=localhost
# Настройки базы данных
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=db_name
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_MIGRATION_PATH=mysql://$MYSQL_USER:$MYSQL_PASSWORD@tcp(tm_db:$MYSQL_EXT_PORT)/$MYSQL_DATABASE

LOGGER_LEVEL=info
LOGGER_AS_JSON=true

# Настройки кэша
REDIS_PORT=6379
REDIS_HOST=localhost

REDIS_MAX_IDLE=10
REDIS_CACHE_TTL=10s
REDIS_IDLE_TIMEOUT=10s
REDIS_CONNECTION_TIMEOUT=10s